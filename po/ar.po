# Frozen history authentication translations.
#, python-brace-format
msgid "The raw message for history source {commit} no longer matches its frozen digest."
msgstr "لم تعد الرسالة الخام لمصدر التاريخ {commit} تطابق بصمتها المجمّدة."

msgid "The persisted rewrite plan no longer matches its checkpoint."
msgstr "لم تعد خطة إعادة الكتابة المحفوظة تطابق نقطة التحقق الخاصة بها."

# Descriptor-pinned private publication translations.
#, python-brace-format
msgid "cannot authenticate locked directory: {error}"
msgstr "لا يمكن مصادقة الدليل المقفل: {error}"

msgid "staging directory is not the locked workspace"
msgstr "دليل التجهيز ليس مساحة العمل المقفلة"

# Persistent rewrite output verification translations.
msgid "The persistent rewrite output object closure is incomplete or invalid."
msgstr "إغلاق كائنات ناتج إعادة الكتابة الدائم غير مكتمل أو غير صالح."

msgid "Git returned malformed object closure data while verifying rewrite output."
msgstr "أعاد ⁦Git⁩ بيانات مشوّهة لإغلاق الكائنات أثناء التحقق من ناتج إعادة الكتابة."

# Operation-owned resolution translations.
msgid "Rewrite resolution provenance does not match the persisted plan."
msgstr "لا يتطابق أصل حل إعادة الكتابة مع الخطة المحفوظة."

msgid "The operation-owned rewrite resolution workspace changed."
msgstr "تغيّرت مساحة عمل حل إعادة الكتابة المملوكة للعملية."

msgid "source and destination workspaces must be disjoint"
msgstr "يجب أن تكون مساحتا عمل المصدر والوجهة منفصلتين"

msgid "destination workspace already exists"
msgstr "مساحة عمل الوجهة موجودة بالفعل"

msgid "source resolution workspace changed while it was copied"
msgstr "تغيّرت مساحة عمل حل المصدر أثناء نسخها"

msgid "owned resolution copy does not match its authenticated source"
msgstr "لا تطابق نسخة الحل المملوكة مصدرها المصادق عليه"

# Applied-batch review provenance translations.
#, python-brace-format
msgid "All working tree changes are currently saved in {locations}."
msgstr "كل تغييرات شجرة العمل محفوظة حاليًا في {locations}."

#, python-brace-format
msgid "Applied-batch state is corrupt: {path}. Remove this file to forget restored-change review provenance."
msgstr "حالة الدفعات المطبقة تالفة: {path}. احذف هذا الملف لنسيان مصدر مراجعة التغييرات المستعادة."
