msgstr "Anwenden"

#: src/git_stage_batch/batch/operation_candidate_labels.py:14
msgctxt "candidate operation noun"
msgid "include"
msgstr "Aufnehmen"

#: src/git_stage_batch/batch/operation_candidates.py:281
