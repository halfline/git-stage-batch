#: src/git_stage_batch/batch/merge/legacy_intent.py:147
#, python-brace-format
msgid ""
"Cannot safely replay legacy batch metadata for {file}: the batch does not "
"record whether adjacent historical source content was an alternative that "
"should be replaced. Recreate this batch with the current version of git-"
"stage-batch before replaying it."
msgstr ""
"Veraltete Stapelmetadaten für {file} können nicht sicher wiedergegeben "
"werden: Der Stapel zeichnet nicht auf, ob benachbarter historischer "
"Quellinhalt eine Alternative war, die ersetzt werden sollte. Erstellen Sie "
"diesen Stapel vor der Wiedergabe mit der aktuellen Version von git-stage-"
"batch neu."

#: src/git_stage_batch/batch/merge/merge.py:682
#: src/git_stage_batch/batch/merge/merge.py:697
#: src/git_stage_batch/batch/merge/merge.py:713
#: src/git_stage_batch/batch/merge/merge.py:1173
#: src/git_stage_batch/batch/merge/merge.py:1315
msgid ""
"Cannot reliably place split replacement: original replacement boundary is "
"not present"
msgstr ""
"Die geteilte Ersetzung kann nicht zuverlässig positioniert werden: Die "
"ursprüngliche Ersetzungsgrenze ist nicht vorhanden"

#: src/git_stage_batch/batch/merge/presence_constraints.py:643
#, python-brace-format
msgid "Cannot satisfy claimed line {line}: removed by absence constraints"
msgstr ""
"Die beanspruchte Zeile {line} kann nicht erfüllt werden: Sie wurde durch "
"Abwesenheitsbedingungen entfernt"

#: src/git_stage_batch/batch/merge/validation.py:1141
#, python-brace-format
msgid "Cannot reliably place claimed line {line}: file completely rewritten"
msgstr ""
"Die beanspruchte Zeile {line} kann nicht zuverlässig positioniert werden: "
"Die Datei wurde vollständig neu geschrieben"

#: src/git_stage_batch/batch/merge/validation.py:1149
#, python-brace-format
msgid "Claimed line {line} is out of range (batch source has {count} line)"
msgid_plural ""
"Claimed line {line} is out of range (batch source has {count} lines)"
msgstr[0] ""
"Die beanspruchte Zeile {line} liegt außerhalb des gültigen Bereichs (die "
"Stapelquelle enthält {count} Zeile)"
msgstr[1] ""
"Die beanspruchte Zeile {line} liegt außerhalb des gültigen Bereichs (die "
"Stapelquelle enthält {count} Zeilen)"

#: src/git_stage_batch/batch/merge/validation.py:1172
#, python-brace-format
msgid "Deletion after line {line} is out of range"
msgstr "Die Löschung nach Zeile {line} liegt außerhalb des gültigen Bereichs"

#: src/git_stage_batch/batch/merge/validation.py:1200
#, python-brace-format
msgid ""
"Cannot determine deletion position after line {line}: anchor and neighbors "
"missing"
msgstr ""
"Die Löschposition nach Zeile {line} kann nicht bestimmt werden: Anker und "
"Nachbarzeilen fehlen"

