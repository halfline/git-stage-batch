"'{selector}' is an {actual} candidate, not an {expected} candidate.\n"
"No changes applied."
msgstr ""
"'{selector}' es un candidato {actual}, no un candidato {expected}.\n"
"No se aplicaron cambios."

#: src/git_stage_batch/batch/source/selector.py:109
