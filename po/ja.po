"{file} のサブモジュールポインターを {action} できません: 保存済みコミット ID "
"がありません。"

#: src/git_stage_batch/batch/submodule_pointer.py:62
#, python-brace-format
msgid ""
"Cannot {action} submodule pointer for {file}: invalid stored change type."
