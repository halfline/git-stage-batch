msgstr ""
"Kan niet determine deletion position after regel {line}: anchor and "
"neighbors missing"

#: src/git_stage_batch/batch/ownership/display_lines.py:116
#: src/git_stage_batch/data/file_hunk_display.py:203
#, python-brace-format
