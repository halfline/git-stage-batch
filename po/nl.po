msgstr "Batch-naam mag niet leeg zijn"

#: src/git_stage_batch/batch/state/batch_names.py:60
#, python-brace-format
msgid "Batch name cannot contain: {char}"
msgstr "Batch-naam mag niet bevatten: {char}"

