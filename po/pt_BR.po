#: src/git_stage_batch/batch/discard_reversal.py:48
#, python-brace-format
msgid "Cannot discard source line {line}: no baseline restoration region found"
msgstr ""
"Não é possível discard linha de origem {line}: no baselinha restoration "
"region found"

