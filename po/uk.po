"'{selector}' є кандидатом {actual}, а не кандидатом {expected}.\n"
"Зміни не застосовано."

#: src/git_stage_batch/batch/source/selector.py:112
#, python-brace-format
msgid ""
"\n"
"\n"
"Preview {expected} candidates with:\n"
